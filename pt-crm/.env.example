# ── Required for production ──────────────────────────────────────────
# Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-long-random-string-min-32-chars

# Public URL users open (invite links, OG metadata, cookies). Production example:
# APP_URL=https://floorscribe.com
APP_URL=http://localhost:4000

# Host port published by docker compose (default 4000)
FLOORSCRIBE_PORT=4000
# PTCRM_PORT=4000   # legacy alias still accepted by docker-compose

# ── Optional AI (SpaceXAI / xAI OpenAI-compatible) ───────────────────
# Without a key, coach uses rule-based playbook matching only.
XAI_API_KEY=
# AI_API_KEY=          # alias accepted by the app
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.5

# ── Local dev (not needed in Docker) ─────────────────────────────────
# PGLITE_DATA_DIR=./data/pglite
#
# If you open the app from another device on your LAN (not localhost),
# list those hostnames/IPs so Next.js serves client JS (buttons work):
# ALLOWED_DEV_ORIGINS=192.168.x.x,my-laptop.local
