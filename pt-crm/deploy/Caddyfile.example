# Example reverse proxy for PT CRM on a Proxmox LXC / VPS
# Install Caddy, point DNS at this host, then:
#   caddy run --config /etc/caddy/Caddyfile
#
# Replace pt-crm.example.com with your domain.

pt-crm.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3000

	# Optional: basic rate limit at edge (Caddy v2.8+ rate_limit plugin, or use fail2ban)
	header {
		# Harden a bit
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/pt-crm.log
	}
}
